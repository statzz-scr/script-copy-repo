local function getBrainrotImageUrl(displayName)
    if not displayName or displayName == "" then return nil end

    local page = displayName:gsub("%s+", "_"):gsub("^%s*(.-)%s*$", "%1")
    local url  = "https://stealabrainrot.fandom.com/wiki/"..page

    local ok, html = pcall(function()
        return game:HttpGet(url, true)
    end)
    if not ok or not html then return nil end
    if html:find("Search results") or html:find("not exist") then return nil end
    --// og img lol
    local og = html:match('<meta%s+property="og:image"%s+content="([^"]+)')
    if og then
        local clean = og:match("(https?://[^?\"'>]+)")
        if clean and clean:find("stealabr/images/") then return clean end
    end

    --// infobox
    local box = html:match('<aside.-</aside>')
    if not box then return nil end

    --// ну блин
    local img =
        box:match('src="([^"]+)"[^>]-thumbnail') or
        box:match('<figure.-src="([^"]+)"') or
        box:match('src="([^"]+)"')

    if not img then return nil end

    return img:match("(https?://[^?\"'>]+)")
end
