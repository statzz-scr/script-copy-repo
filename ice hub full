            local minGen = tonumber(minGenerationRaw)
            if not minGen or minGen <= 0 then
                minGen = 1000000
            end

            local found = false
            local plots = Workspace:FindFirstChild("Plots")

            if plots then
                for _, plot in ipairs(plots:GetChildren()) do
                    do
                        local podiums = plot:FindFirstChild("AnimalPodiums")
                        if podiums then
                            for _, podium in ipairs(podiums:GetChildren()) do
                                local genObj =
                                    podium:FindFirstChild("Base")
                                    and podium.Base:FindFirstChild("Spawn")
                                    and podium.Base.Spawn:FindFirstChild("Attachment")
                                    and podium.Base.Spawn.Attachment:FindFirstChild("AnimalOverhead")
                                    and podium.Base.Spawn.Attachment.AnimalOverhead:FindFirstChild("Generation")

                                if genObj then
                                    local val = parseGenerationValue(genObj.Text)
                                    if val and val >= minGen then
                                        found = true
                                        break
                                    end
                                end
                            end
                        end
                    end

                    if found then break end

                    for _, obj in ipairs(plot:GetDescendants()) do
                        if obj.Name == "OVERHEAD_ATTACHMENT" then
                            local genObj =
                                obj:FindFirstChild("AnimalOverhead")
                                and obj.AnimalOverhead:FindFirstChild("Generation")

