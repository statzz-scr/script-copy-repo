local function toggleAimbot(Value)
    aimbotEnabled = Value
    config.aimbotEnabled = Value
    saveConfig()
    
    if Value then
        print("✅ Laser Cape + Web Slinger запущены!")
        
        -- Настройки
        local LASER_CAPE_NAME = "Laser Cape"
        local WEBSLINGER_NAME = "Web Slinger"
        local MAX_KILL_DISTANCE = 150
        local KILL_DURATION = 2.0
        local TELEPORT_DISTANCE = 10
        local TELEPORT_DELAY = 0.05
        local FIRE_DELAY = 0.1
        local LASER_AIM_DISTANCE = 50
        local SILENT_AIM_ENABLED = true
        local DEFAULT_WALK_SPEED = 16
        local DEFAULT_JUMP_POWER = 50
        
        local function captureDefaultHumanoidSettings(humanoid)
            DEFAULT_WALK_SPEED = humanoid.WalkSpeed
            DEFAULT_JUMP_POWER = humanoid.JumpPower
        end
        
        local function getTargetPlayer(maxDistance, bodyPartName)
            local myChar = LocalPlayer.Character
            local currentMyHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not currentMyHRP then return nil end

            local closest, closestDist = nil, maxDistance

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local targetHumanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                    local targetPart = plr.Character:FindFirstChild(bodyPartName)
                    
                    if targetPart and targetHumanoid and targetHumanoid.Health > 0 then
                        local dist = (targetPart.Position - currentMyHRP.Position).Magnitude
                        if dist < closestDist then
                            closest, closestDist = plr, dist
                        end
                    end
                end
            end
            return closest
        end
        
        local function onLaserCapeActivated(tool)
            if SILENT_AIM_ENABLED then
                local character = LocalPlayer.Character
                local currentMyHRP = character and character:FindFirstChild("HumanoidRootPart")
                if not currentMyHRP then return end
                
                local myMouse = LocalPlayer:GetMouse()
                local clickPos = myMouse.Hit.Position 
                local targetPos = clickPos
                local targetPart = nil
                
                local nearestPlayer = getTargetPlayer(LASER_AIM_DISTANCE, "HumanoidRootPart")
                
                if nearestPlayer and nearestPlayer.Character then
                    targetPart = nearestPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetPart then
                        targetPos = targetPart.Position
                    end
                end
                
                pcall(function()
                    local remoteEvent = ReplicatedStorage:WaitForChild('Packages', 2):WaitForChild('Net', 2):WaitForChild('RE/UseItem', 2)
                    remoteEvent:FireServer(targetPos, targetPart)
                end)
                return true 
            end
        end
        
        local function startTeleportLoop(targetHRP, stopSignal, myHRP)
            if targetHRP == myHRP or not targetHRP.Parent then 
                return 
            end
            
            local up = true
            task.spawn(function()
                while not stopSignal.Stop and targetHRP.Parent and targetHRP ~= myHRP do 
                    local offset = Vector3.new(0, TELEPORT_DISTANCE, 0)
                    if up then
                        targetHRP.CFrame = targetHRP.CFrame * CFrame.new(offset)
                    else
                        targetHRP.CFrame = targetHRP.CFrame * CFrame.new(-offset)
                    end
                    up = not up
                    task.wait(TELEPORT_DELAY)
                end
            end)
        end
        
        local function fireWebSlinger(targetPart)
            pcall(function()
                local remoteEvent = ReplicatedStorage:WaitForChild('Packages', 2):WaitForChild('Net', 2):WaitForChild('RE/UseItem', 2)
                remoteEvent:FireServer(targetPart.Position, targetPart)
            end)
        end
        
        local function startWebSlingerSpam(targetLowerTorso, stopSignal)
            task.spawn(function()
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                
                if backpack and backpack:FindFirstChild(WEBSLINGER_NAME) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                     LocalPlayer.Character.Humanoid:EquipTool(backpack[WEBSLINGER_NAME])
                     task.wait(0.1) 
                end
                
                local targetHumanoid = targetLowerTorso.Parent and targetLowerTorso.Parent:FindFirstChildOfClass("Humanoid")
                
                while not stopSignal.Stop and targetLowerTorso.Parent and targetHumanoid and targetHumanoid.Health > 0 do
                    fireWebSlinger(targetLowerTorso)
                    task.wait(FIRE_DELAY)
                end
            end)
        end
        
        local function startFreezeLoop(humanoid, stopSignal)
            local freezeConn = RunService.Heartbeat:Connect(function()
                if not stopSignal.Stop and humanoid.Parent then
                    humanoid.WalkSpeed = 0
                    humanoid.JumpPower = 0
                end
            end)
            
            task.spawn(function()
                task.wait(KILL_DURATION)
                
                stopSignal.Stop = true
                freezeConn:Disconnect()
                
                if humanoid.Parent then
                    humanoid.WalkSpeed = DEFAULT_WALK_SPEED
                    humanoid.JumpPower = DEFAULT_JUMP_POWER
                end
            end)
        end
        
        local function executeKillPlayer()
            local target = getTargetPlayer(MAX_KILL_DISTANCE, "LowerTorso")
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local currentMyHRP = character and character:FindFirstChild("HumanoidRootPart")

            if not target or not target.Character or not humanoid or not currentMyHRP then
                return
            end

            local targetLT = target.Character:FindFirstChild("LowerTorso")
            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")

            if not targetLT or not targetHRP then
                return
            end

            local stopSignal = {Stop = false}
            
            startFreezeLoop(humanoid, stopSignal)
            startTeleportLoop(targetHRP, stopSignal, currentMyHRP)
            startWebSlingerSpam(targetLT, stopSignal)
            
            return true
        end
        
        local function setupTool(tool)
            if tool:IsA("Tool") then
                if tool.Name == LASER_CAPE_NAME then
                    tool.Activated:Connect(function() return onLaserCapeActivated(tool) end)
                
                elseif tool.Name == WEBSLINGER_NAME then
                    tool.Activated:Connect(function() return executeKillPlayer() end)
                end
            end
        end

        local function scanAndSetupTools()
            local backpack = LocalPlayer:FindFirstChild("Backpack", 5)
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

            local function processChildren(container)
                for _, tool in ipairs(container:GetChildren()) do
                    setupTool(tool)
                end
            end

            if backpack then processChildren(backpack) end
            if character then processChildren(character) end

            if backpack then backpack.ChildAdded:Connect(setupTool) end
            
            LocalPlayer.CharacterAdded:Connect(function(newChar)
                newChar.ChildAdded:Connect(setupTool)
                processChildren(newChar)
            end)
        end

        scanAndSetupTools()
        
        aimbotConnection = RunService.RenderStepped:Connect(function()
            if not aimbotEnabled then return end
        end)
    else
        if aimbotConnection then
            aimbotConnection:Disconnect()
            aimbotConnection = nil
        end
        ContextActionService:UnbindAction('AimbotAction')
    end
end

local function toggleAutoSteal(Value)
    autoStealEnabled = Value
    config.autoStealEnabled = Value
    saveConfig()

    if not Value then
        return
    end

    local TARGET_HOLD_DURATION = 1.5
    local TARGET_MAX_DISTANCE = 10
    local CHECK_INTERVAL = 0.25
    local HOLD_TIME = 0.6

    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local RootPart = Character:WaitForChild("HumanoidRootPart")

    LocalPlayer.CharacterAdded:Connect(function(c)
        task.wait(0.12)
        Character = c
        RootPart = c:WaitForChild("HumanoidRootPart")
    end)

    local function getBasePart(p) 
        local par = p.Parent
        if par:IsA("BasePart") then return par end
        if par:IsA("Attachment") and par.Parent:IsA("BasePart") then return par.Parent end
        if par:IsA("Model") and par.PrimaryPart then return par.PrimaryPart end
        return nil
    end

    local function isCandidate(prompt)
    if not prompt.Enabled or prompt.ActionText ~= "Steal" then
        return false
    end
    if math.abs((prompt.HoldDuration or 0) - TARGET_HOLD_DURATION) > 0.1
        or math.abs((prompt.MaxActivationDistance or 0) - TARGET_MAX_DISTANCE) > 1 then
        return false
    end

    local part = getBasePart(prompt)
    if not part or not RootPart then return false end

    local plot = part:FindFirstAncestorWhichIsA("Model")
    if plot and plot.Parent == Workspace.Plots and plot == myPlot then
        return false
    end

    local dist = (part.Position - RootPart.Position).Magnitude
    return dist <= TARGET_MAX_DISTANCE + 0.5, part, dist
end

    local function findClosest()
        local best, bestDist = nil, math.huge
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local ok, part, dist = isCandidate(v)
                if ok and dist < bestDist then
                    best = v
                    bestDist = dist
                end
            end
        end
        return best
    end

    local function tryActivate(prompt)
        if not prompt then return end
        pcall(function()
            if typeof(prompt.InputHoldBegin) == "function" then
                prompt:InputHoldBegin()
                task.wait(HOLD_TIME)
                prompt:InputHoldEnd()
