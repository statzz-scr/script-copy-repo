local ZERO_VECTOR = Vector3.new()
local function recoverFromRagdoll()
    if antiRagdollIsRecovering or not antiRagdollEnabled then return end
    antiRagdollIsRecovering = true

    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = hum and character:FindFirstChild("HumanoidRootPart")
    if not root or not hum then
        antiRagdollIsRecovering = false
        return
    end

    if ANTI_RAGDOLL_CONFIG.ANCHOR_ON_RECOVER then
        root.Anchored = true
    end
    RunService.Heartbeat:Wait()
    root.CFrame = antiRagdollSafeCFrame
    if ANTI_RAGDOLL_CONFIG.ANCHOR_ON_RECOVER then
        root.Anchored = false
    end
    hum:ChangeState(Enum.HumanoidStateType.Running)
    hum.PlatformStand = false
    if ANTI_RAGDOLL_CONFIG.CLEAR_ATTACHMENTS or ANTI_RAGDOLL_CONFIG.CLEAR_CONSTRAINTS then
        for _, d in character:GetDescendants() do
            local isAttach = d:IsA("Attachment")
            local isConstr = d:IsA("Constraint")
            if (ANTI_RAGDOLL_CONFIG.CLEAR_ATTACHMENTS and isAttach) or (ANTI_RAGDOLL_CONFIG.CLEAR_CONSTRAINTS and isConstr)then
                pcall(function()d:Destroy()end)
            end
        end
    end
    if ANTI_RAGDOLL_CONFIG.RESET_VELOCITY then
        for _, p in character:GetChildren() do
            if p:IsA("BasePart") then
                p.Velocity = ZERO_VECTOR
                p.RotVelocity = ZERO_VECTOR
            end
        end
    end
    antiRagdollIsRecovering = false
end


local function monitorPart(part)
    if not part:IsA("BasePart") then return end
    local conn = part.ChildAdded:Connect(function(child)
        if not antiRagdollEnabled then return end
        local class = child.ClassName
        if class == "Attachment" or class:find("Constraint") then
            pcall(function() child:Destroy() end)
            if humanoid:GetState() == Enum.HumanoidStateType.Physics then
                task.spawn(recoverFromRagdoll)
            end
        end
    end)

    table.insert(antiRagdollConnections, conn)
end


local function initAntiRagdoll(char)
    clearAntiRagdollConnections()
    character = char
    humanoid = char:WaitForChild("Humanoid")
    humanoidRootPart = char:WaitForChild("HumanoidRootPart")

    antiRagdollSafeCFrame  = humanoidRootPart.CFrame
    antiRagdollLastUpdate  = tick()
    antiRagdollIsRecovering = false

    table.insert(antiRagdollConnections,RunService.Heartbeat:Connect(function()
        if not antiRagdollEnabled or humanoid.Health <= 0 or not character.Parent then return end
        local t = tick()
        if t - antiRagdollLastUpdate >= ANTI_RAGDOLL_CONFIG.UPDATE_RATE then
            antiRagdollSafeCFrame = humanoidRootPart.CFrame
            antiRagdollLastUpdate = t
        end
    end))

    table.insert(antiRagdollConnections,humanoid.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Physics and antiRagdollEnabled and not antiRagdollIsRecovering then
            task.spawn(recoverFromRagdoll)
        end
    end))

    for _, part in ipairs(char:GetChildren()) do
        monitorPart(part)
    end

    table.insert(antiRagdollConnections,char.ChildAdded:Connect(monitorPart))

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Attachment") or obj:IsA("Constraint") then
            pcall(function() obj:Destroy() end)
        end
    end
end
