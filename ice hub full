local CACHE_FILE = "PlutosServerCache.json"
local CACHE_DURATION = 300 -- 5 минут
local MAX_SERVERS_PER_REQUEST = 100

local function formatTime(timestamp)return os.date("%Y-%m-%d %H:%M:%S", timestamp)end

local function loadServerCache()
    if not isfile or not readfile then return nil end
    if not isfile(CACHE_FILE) then return nil end
    
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(CACHE_FILE))
    end)
    
    if not success or not data then return nil end

    if tick() - (data.timestamp or 0) > CACHE_DURATION then
        return nil
    end
    
    return data.servers or {}
end

local function saveServerCache(servers)
    if not writefile then return end
    local now = tick()
    local cacheData = {
        timestamp = now,
        lastSaved = formatTime(now),  -- ЧЕЛОВЕЧЕСКОЕ ВРЕМЯ
        servers = servers,
        total = #servers
    }
    pcall(writefile,CACHE_FILE,HttpService:JSONEncode(cacheData))
end

local function getAvailableServers()
    local cached = loadServerCache()
    if cached and #cached > 0 then return cached end
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=" .. MAX_SERVERS_PER_REQUEST))
    end)
    if not success or not result or not result.data then
        return cached or {}
    end

    local validServers = {}
    for _, server in ipairs(result.data) do
        if server.playing < server.maxPlayers and server.id ~= game.JobId then
            table.insert(validServers, server.id)
        end
    end

    if #validServers > 0 then
        saveServerCache(validServers)
    end

    return validServers
end

