                    "✅ Index(10M+): chunk %d/%d, %d item(s) đã gửi (delay %ds)",
                    ci, #indexChunks, #chunk, INDEX_DELAY_SEC
                ))
            end
        end)
    end

    ------------------------------------------------------
    -- 🟢 LOW (webhook_low): 1–9M → gửi NGAY full info
    ------------------------------------------------------
    if #groupLow > 0 then
        safeSend(webhook_low, makePayload(groupLow, 0x00FF00, placeId, jobId))
        print(string.format(
            "📩 Low(1–9M): %d item(s) gửi NGAY (full info)",
