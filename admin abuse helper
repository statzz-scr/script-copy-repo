-- Function to create a single toggle tile
local function createToggle(name)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(0.95, 0, 0, 66)
    holder.BackgroundTransparency = 1
    holder.Parent = scrollingFrame

    local tile = Instance.new("Frame", holder)
    tile.Size = UDim2.new(1, 0, 1, 0)
    tile.BackgroundColor3 = Color3.fromRGB(33, 33, 33)
    tile.BorderSizePixel = 0
    Instance.new("UICorner", tile).CornerRadius = UDim.new(0, 12)

    local tileStroke = Instance.new("UIStroke", tile)
    tileStroke.Thickness = 1
    tileStroke.Transparency = 0.9

    -- Icon circle (first letter of the toggle name)
    local iconFrame = Instance.new("Frame", tile)
    iconFrame.Size = UDim2.new(0, 46, 0, 46)
    iconFrame.Position = UDim2.new(0, 10, 0.5, -23)
    iconFrame.BackgroundColor3 = Color3.fromRGB(46, 46, 46)
    Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(0, 10)

    local iconLabel = Instance.new("TextLabel", iconFrame)
    iconLabel.Size = UDim2.new(1, 0, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Text = string.sub(name, 1, 1)
    iconLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    iconLabel.TextSize = 18
    iconLabel.TextYAlignment = Enum.TextYAlignment.Center

    -- Toggle name label
    local nameLabel = Instance.new("TextLabel", tile)
    nameLabel.Size = UDim2.new(0.58, 0, 1, 0)
    nameLabel.Position = UDim2.new(0, 66, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.Text = name
    nameLabel.TextSize = 16
    nameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextYAlignment = Enum.TextYAlignment.Center

    -- Toggle switch background
    local switchBg = Instance.new("Frame", tile)
    switchBg.Size = UDim2.new(0, 84, 0, 36)
    switchBg.Position = UDim2.new(1, -100, 0.5, -18)
    switchBg.BackgroundColor3 = Color3.fromRGB(58, 58, 58)
    switchBg.BorderSizePixel = 0
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(0, 18)

    local switchStroke = Instance.new("UIStroke", switchBg)
    switchStroke.Thickness = 1
    switchStroke.Transparency = 0.9

    -- Toggle knob
    local knob = Instance.new("Frame", switchBg)
    knob.Size = UDim2.new(0, 28, 0, 28)
    knob.Position = UDim2.new(0, 6, 0, 4)
    knob.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 14)

    -- Invisible click detector
    local clickDetector = Instance.new("TextButton", tile)
    clickDetector.Size = UDim2.new(1, 0, 1, 0)
    clickDetector.BackgroundTransparency = 1
    clickDetector.Text = ""
    clickDetector.AutoButtonColor = false

    local isEnabled = false
    local stateChanged = Instance.new("BindableEvent")

    local function setState(enabled)
        isEnabled = enabled

        if enabled then
            TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -34, 0, 4)
            }):Play()
            TweenService:Create(switchBg, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(45, 135, 255) }):Play()
            TweenService:Create(iconFrame, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(38, 120, 255) }):Play()
        else
            TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 6, 0, 4)
            }):Play()
            TweenService:Create(switchBg, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(58, 58, 58) }):Play()
            TweenService:Create(iconFrame, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(46, 46, 46) }):Play()
        end

        stateChanged:Fire(isEnabled)
    end

    clickDetector.MouseButton1Click:Connect(function()
        setState(not isEnabled)
    end)

    return {
        Holder = holder,
        Tile = tile,
        Touch = clickDetector,
        GetState = function() return isEnabled end,
        SetState = setState,
        Changed = stateChanged.Event
    }
end

