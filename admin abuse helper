-- ==================== Feature: Auto Buy ====================

if toggles["Auto Buy"] then
    local Workspace = game:GetService("Workspace")
    local activePrompts = {}
    local isRunning = false
    local renderConnection, descendantConnection

    local function isValidPrompt(obj)
        return obj and obj:IsA("ProximityPrompt") and
               obj.Parent and obj.Parent.Name == "PromptAttachment" and
               obj.Parent.Parent and obj.Parent.Parent.Name == "Part" and
               obj.Parent.Parent.Parent and obj.Parent.Parent.Parent:IsA("Model")
    end

    local function getPromptPosition(prompt)
        if prompt.Parent.Name == "PromptAttachment" then
            return prompt.Parent.Parent.Position
        elseif prompt.Parent:IsA("BasePart") then
            return prompt.Parent.Position
        elseif prompt.Parent:IsA("Model") and prompt.Parent.PrimaryPart then
            return prompt.Parent.PrimaryPart.Position
        end
        return nil
    end

    local function isOnScreen(prompt)
        local pos = getPromptPosition(prompt)
        if not pos then return false end
        local _, onScreen = workspace.CurrentCamera:WorldToViewportPoint(pos)
        return onScreen
    end

    local function holdInput(prompt)
        for _, input in pairs({ Enum.UserInputType.Keyboard, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch }) do
            pcall(function() prompt:InputHoldBegin(input) end)
        end
    end

    local function releaseInput(prompt)
        for _, input in pairs({ Enum.UserInputType.Keyboard, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch }) do
            pcall(function() prompt:InputHoldEnd(input) end)
        end
    end

    local function startAutoBuy()
        if isRunning then return end
        isRunning = true

        -- Index existing prompts
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isValidPrompt(obj) then
                activePrompts[obj] = true
            end
        end

        -- Listen for new prompts
        descendantConnection = Workspace.DescendantAdded:Connect(function(obj)
            if isValidPrompt(obj) then
                activePrompts[obj] = true
            end
        end)

        -- Main loop
        renderConnection = RunService.RenderStepped:Connect(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            for prompt in pairs(activePrompts) do
                if prompt.Parent and isValidPrompt(prompt) then
                    local pos = getPromptPosition(prompt)
                    if pos and (hrp.Position - pos).Magnitude <= 15 and isOnScreen(prompt) then
                        holdInput(prompt)
                    else
                        releaseInput(prompt)
                    end
                else
                    activePrompts[prompt] = nil
                end
            end
        end)
    end

    local function stopAutoBuy()
        if not isRunning then return end
        isRunning = false

        if renderConnection then renderConnection:Disconnect() end
        if descendantConnection then descendantConnection:Disconnect() end

        for prompt in pairs(activePrompts) do
            releaseInput(prompt)
        end
        activePrompts = {}
    end

    toggles["Auto Buy"].Changed:Connect(function(enabled)
        if enabled then
            startAutoBuy()
        else
            stopAutoBuy()
        end
    end)

    if toggles["Auto Buy"]:GetState() then
        startAutoBuy()
    end

    LocalPlayer.CharacterRemoving:Connect(function()
        for prompt in pairs(activePrompts) do
            releaseInput(prompt)
        end
        activePrompts = {}
    end)
end

