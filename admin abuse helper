-- ==================== Settings Save/Load ====================

local SETTINGS_FILE = "StealMenuSettings.json"

local function canUseFileSystem()
    return (typeof(writefile) == "function" and typeof(readfile) == "function") or
           (typeof(syn) == "table" and typeof(syn.write_file) == "function" and typeof(syn.read_file) == "function")
end

local function writeFile(filename, content)
    if typeof(writefile) == "function" then
        writefile(filename, content)
        return true
    elseif typeof(syn) == "table" and typeof(syn.write_file) == "function" then
        syn.write_file(filename, content)
        return true
    end
    return false
end

local function readFile(filename)
    if typeof(readfile) == "function" then
        return readfile(filename)
    elseif typeof(syn) == "table" and typeof(syn.read_file) == "function" then
        return syn.read_file(filename)
    end
    return nil
end

local function saveSettings()
    local settings = {}
    for name, toggle in pairs(toggles) do
        if name ~= "Desync" and name ~= "Floor Steal" then
            settings[name] = toggle:GetState()
        end
    end

    local success, json = pcall(HttpService.JSONEncode, HttpService, settings)
    if success and canUseFileSystem() then
        pcall(function()
            writeFile(SETTINGS_FILE, json)
        end)
    end
end

local function loadSettings()
    if not canUseFileSystem() then return nil end

    local success, content = pcall(readFile, SETTINGS_FILE)
    if not success or not content then return nil end

    local decodedSuccess, data = pcall(HttpService.JSONDecode, HttpService, content)
    if decodedSuccess then
        return data
    end
    return nil
end

-- Apply loaded settings
local loaded = loadSettings()
if loaded then
    for name, state in pairs(loaded) do
        if toggles[name] then
            toggles[name]:SetState(state)
        end
    end
else
    -- Fallback: use player attributes if available
    for name, toggle in pairs(toggles) do
        if name ~= "Desync" and name ~= "Floor Steal" then
            local attr = LocalPlayer:GetAttribute("StealTools_" .. name)
            if attr ~= nil then
                toggle:SetState(attr)
            end
        end
    end
end

