-- GUI State Functions
function GUI:ToggleExpanded()
    self.IsExpanded = not self.IsExpanded
    mainPanel.Visible = true

    if self.IsExpanded then
        TweenService:Create(mainPanel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 350, 0, 200) }):Play()
        TweenService:Create(mainPanel, TweenInfo.new(0.15), { BackgroundTransparency = 0.05 }):Play()
    else
        local tween = TweenService:Create(mainPanel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 350, 0, 0) })
        TweenService:Create(mainPanel, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        tween:Play()
        tween.Completed:Connect(function()
            if not self.IsExpanded then mainPanel.Visible = false end
        end)
    end
end

function GUI:ToggleVisibility()
    self.IsVisible = not self.IsVisible
    -- Similar fade in/out logic...
end

function GUI:SwitchTab(tab)
    self.currentTab = tab
    tabMain.TextColor3 = tab == "Main" and Colors.accent or Colors.tabInactive
    tabSettings.TextColor3 = tab == "Settings" and Colors.accent or Colors.tabInactive
    mainContent.Visible = (tab == "Main")
    settingsContent.Visible = (tab == "Settings")
end

function GUI:ToggleAutoJoin()
    self.autoJoinEnabled = not self.autoJoinEnabled
    autoJoinBtn.BackgroundColor3 = self.autoJoinEnabled and Colors.btnActive or Colors.btnInactive
end

function GUI:UpdateMessage(money, name, jobid)
    self.LastMessage = { money = money, name = name, jobid = jobid or "" }
    serverInfoLabel.Text = name .. " - " .. money .. " M/s"

    if self.autoJoinEnabled and jobid and jobid ~= "" then
        local moneyNum = tonumber(money) or 0
        if moneyNum >= self.Settings.MinimumMoney then
            if isValidJobId(jobid) then
                triggerJoinJobId(jobid)
            else
                -- Fallback teleport (rare case)
                TeleportService:TeleportToPlaceInstance(109983668079237, jobid, Players.LocalPlayer)
            end
        end
    end
end

function GUI:SetConnectionStatus(connected)
    self.IsConnected = connected
    statusDot.BackgroundColor3 = connected and Colors.green or Colors.red
end

-- Button hover effects
local function addButtonHover(btn, idle, hover, press)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = hover}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = idle}):Play() end)
    btn.MouseButton1Down:Connect(function() TweenService:Create(btn, TweenInfo.new(0.05), {BackgroundColor3 = press}):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(btn, TweenInfo.new(0.05), {BackgroundColor3 = hover}):Play() end)
end

