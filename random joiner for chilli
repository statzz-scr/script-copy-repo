-- Utility: Check if string is a valid Roblox JobId (64-char hex)
local function isValidJobId(str)
    return type(str) == "string" and #str > 50 and str:match("^[0-9A-Fa-f]+$") ~= nil
end

-- Auto-fill and trigger "Join Job-ID" in-game UI (bypasses input)
local function triggerJoinJobId(jobId)
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("TextBox") and obj.Name == "InputBox" and obj.Parent.Name == "Input" then
            obj.Text = jobId

            -- Fire TextChanged connections
            for _, conn in pairs(getconnections(obj:GetPropertyChangedSignal("Text"))) do
                conn:Fire()
            end

            -- Fire FocusLost (Enter press simulation)
            for _, conn in pairs(getconnections(obj.FocusLost)) do
                conn:Fire(true) -- true = Enter pressed
            end

            -- Click the "Join Job-ID" button
            for _, btn in pairs(game:GetDescendants()) do
                if btn:IsA("TextButton") and btn.Name == "ButtonInteract" and btn.Text == "Join Job-ID" then
                    for _, conn in pairs(getconnections(btn.MouseButton1Click)) do
                        conn:Fire()
                    end
                    return
                end
            end
        end
    end
end

-- Save settings to file
