-- WebSocket Connection
function ConnectWebSocket()
    GUI:SetConnectionStatus(false)
    local success, ws = pcall(WebSocket.connect, GUI.Settings.WebSocketURL)
    if not success then return false end

    GUI.WebSocket = ws
    GUI:SetConnectionStatus(true)

    ws.OnMessage:Connect(function(msg)
        local success, data = pcall(HttpService.JSONDecode, HttpService, msg)
        if success and data.jobid and data.money and data.name then
            GUI:UpdateMessage(data.money, data.name, data.jobid)
        end
    end)

    ws.OnClose:Connect(function()
        GUI:SetConnectionStatus(false)
    end)
end

ConnectWebSocket()

