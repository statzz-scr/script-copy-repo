end

-- Load settings on start
if isfile and readfile and isfile("AutoJoinerSettings.json") then
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile("AutoJoinerSettings.json"))
    end)
    if success and data then
        GUI.Settings.MinimumMoney = data.MinimumMoney or DEFAULT_MIN_MONEY
        GUI.Settings.WebSocketURL = data.WebSocketURL or DEFAULT_WS_URL
    end
end

-- Helper: Create Instance with properties
local function create(className, props)
    local obj = Instance.new(className)
    for key, value in pairs(props) do
        if key ~= "Parent" then
            obj[key] = value
        end
    end
    if props.Parent then
        obj.Parent = props.Parent
    end
    return obj
end

local function corner(obj, radius)
